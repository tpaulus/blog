BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Optional regional Storage API hostname. Defaults to storage.bunnycdn.com.
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
# Optional nonempty directory inside the Storage Zone. Leave empty to deploy at its root.
BUNNY_DEPLOY_PREFIX=
BUNNY_DEPLOY_CONCURRENCY=8
# Configure both values to purge the Pull Zone after a successful deployment.
BUNNY_PULL_ZONE_ID=
BUNNY_API_KEY=
# Required to build pages whose feature_image is an Unsplash photo URL.
UNSPLASH_ACCESS_KEY=
